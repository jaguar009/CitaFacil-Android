<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/citafacil_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+  CitaFácil" android:textSize="28sp" android:textColor="@color/citafacil_text" android:textStyle="bold" android:layout_marginTop="28dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu atención, a un paso." android:textSize="32sp" android:textColor="@color/citafacil_text" android:layout_marginTop="36dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reserva un horario y lleva tu agenda contigo." android:textSize="16sp" android:textColor="@color/citafacil_text" android:layout_marginTop="12dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inicia sesión" android:textSize="21sp" android:textColor="@color/citafacil_text" android:id="@+id/authTitle" android:layout_marginTop="36dp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/nameGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Nombre completo" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/authName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLines="1" android:maxLength="120"/></com.google.android.material.textfield.TextInputLayout></LinearLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Correo electrónico" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/authEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" android:maxLength="160" android:autofillHints="emailAddress"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Contraseña (mínimo 10 caracteres)" app:boxBackgroundMode="outline"><com.google.android.material.textfield.TextInputEditText android:id="@+id/authPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:maxLength="128" android:autofillHints="password"/></com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="@color/citafacil_text" android:id="@+id/authMessage" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.button.MaterialButton android:id="@+id/authSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingresar" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginTop="12dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/authToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crear una cuenta" android:textAllCaps="false" app:cornerRadius="12dp" style="@style/Widget.Material3.Button.TextButton"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Demostración académica. Profesionales y servicios ficticios." android:textSize="12sp" android:textColor="@color/citafacil_text" android:layout_marginTop="24dp"/>
</LinearLayout></ScrollView>
